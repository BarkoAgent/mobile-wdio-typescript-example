{
  "env": {
    "browser": true,
    "commonjs": true,
    "es2021": true,
    "node": true,
    "mocha": true
  },
  "plugins": ["@typescript-eslint", "wdio", "prettier"],
  "extends": [
    "eslint:recommended",
    "plugin:wdio/recommended",
    "plugin:prettier/recommended",
    "plugin:chai-friendly/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "wdio/no-pause": "warn",
    "linebreak-style": ["error", "unix"],
    "semi": ["error", "always"],
    "prettier/prettier": [
      "warn",
      {
        "singleQuote": true,
        "printWidth": 120
      }
    ],
    "quotes": [
      "warn",
      "single",
      {
        "avoidEscape": true
      }
    ]
  },
  "parser": "@typescript-eslint/parser",
  "ignorePatterns": ["node_modules/", "allure-report/", "allure-results/", "logs/", "app/"]
}
