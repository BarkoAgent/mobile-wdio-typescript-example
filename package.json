{
  "name": "mobile-wdio-typescript-example",
  "version": "1.0.0",
  "description": "WebdriverIO + Appium + TypeScript mobile test automation example for Android, run against the public WebdriverIO native demo app",
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "eslint": "eslint . --ext .ts,.js",
    "eslint-fix": "eslint . --ext .ts,.js --fix",
    "report": "npx allure open",
    "delete-local-report": "npx rimraf ./allure-results && npx rimraf ./allure-report",
    "app:download": "node scripts/download-app.js"
  },
  "dependencies": {
    "@wdio/cli": "^8.31.1",
    "dotenv": "^18.0.5",
    "webdriverio": "^8.31.1"
  },
  "devDependencies": {
    "@types/webdriverio": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@wdio/allure-reporter": "^8.32.2",
    "@wdio/appium-service": "^8.31.1",
    "@wdio/local-runner": "^8.31.1",
    "@wdio/mocha-framework": "^8.31.1",
    "@wdio/spec-reporter": "^8.31.1",
    "allure-commandline": "^2.27.0",
    "appium": "^2.0.1",
    "appium-uiautomator2-driver": "^3.0.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-chai-friendly": "^0.7.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-wdio": "^8.24.12",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "typescript",
    "mobile",
    "android",
    "mocha",
    "allure",
    "test-automation",
    "example"
  ],
  "license": "MIT"
}
